{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/)"
      }
    },
    "sealed": {
      "$code": {
        "$uid": {
          "$pid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists()"
          }
        }
      }
    },
    "records": {
      ".read": "auth != null",
      "$board": {
        ".indexOn": "n",
        "$id": {
          ".write": "auth != null && $board.matches(/^(p[2-5]|cpu-(easy|medium|hard))$/) && $id.matches(/^[A-Za-z0-9-]{1,60}$/)",
          ".validate": "newData.hasChildren(['n', 'names', 'at']) && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 5000 && newData.child('names').isString() && newData.child('names').val().length <= 200 && newData.child('at').isNumber()"
        }
      }
    }
  }
}
