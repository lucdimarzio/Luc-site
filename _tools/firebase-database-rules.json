{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/)"
      }
    },
    "sealed": {
      "$code": {
        "$uid": {
          "$pid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists()"
          }
        }
      }
    }
  }
}
